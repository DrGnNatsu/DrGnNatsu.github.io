---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title='Page Not Found — Pham Hoang Phuong'
  description='The requested page could not be found.'
>
  <section class='mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8'>
    <p class='font-mono text-sm font-semibold text-accent tabular-nums'>404</p>
    <h1 class='mt-3 text-3xl font-extrabold tracking-tight text-primary sm:text-4xl'>
      Page not found
    </h1>
    <p class='mt-4 text-base text-secondary'>
      The page you are looking for does not exist or has moved during the site
      redesign.
    </p>
    <div class='mt-8 flex flex-wrap justify-center gap-3'>
      <a
        href='/'
        class='rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-hover'
      >
        Back to Home
      </a>
      <a
        href='/projects'
        class='rounded-lg border border-hairline bg-surface px-5 py-2.5 text-sm font-semibold text-primary transition-colors hover:border-hairline-strong'
      >
        Browse Projects
      </a>
      <a
        href='/blog'
        class='rounded-lg border border-hairline bg-surface px-5 py-2.5 text-sm font-semibold text-primary transition-colors hover:border-hairline-strong'
      >
        Read Blog
      </a>
    </div>
  </section>
</BaseLayout>
