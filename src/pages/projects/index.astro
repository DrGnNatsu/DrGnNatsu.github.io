---
import { getCollection } from 'astro:content'
import ProjectCard from '../../components/ProjectCard.astro'
import { profile } from '../../data/profile'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { categoryLabel } from '../../utils/format'

const allProjects = await getCollection('projects')
const projects = [...allProjects].sort((a, b) => {
  if (a.data.featured !== b.data.featured) {
    return a.data.featured ? -1 : 1
  }
  const timeA = a.data.date ? a.data.date.getTime() : 0
  const timeB = b.data.date ? b.data.date.getTime() : 0
  return timeB - timeA
})

const categories = Array.from(new Set(projects.map(p => p.data.category)))
const allTags = Array.from(
  new Set(projects.flatMap(p => [...p.data.tech, ...p.data.tags]))
).sort((a, b) => a.localeCompare(b))
---

<BaseLayout
  title={`Projects — ${profile.name}`}
  description='Selected engineering projects, database tooling, and AI/ML case studies.'
>
  <div class='mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8'>
    <header class='border-b border-hairline pb-10'>
      <p class='font-mono text-xs font-medium text-accent'>Portfolio</p>
      <h1 class='mt-2 text-3xl font-extrabold tracking-tight text-primary sm:text-4xl'>
        Projects & Case Studies
      </h1>
      <p class='mt-3 max-w-2xl text-base leading-relaxed text-secondary'>
        Engineering systems, developer tooling, and architecture write-ups.
        Filter by category or technology stack below.
      </p>
    </header>

    <!-- Filter Controls -->
    <section
      aria-label='Project filters'
      class='mt-8 space-y-4 rounded-xl border border-hairline bg-surface p-5'
    >
      <div class='flex flex-wrap items-center justify-between gap-4'>
        <div
          class='flex flex-wrap items-center gap-2'
          role='group'
          aria-label='Filter by category'
        >
          <span class='mr-1 font-mono text-xs text-secondary'>Category:</span>
          <button
            type='button'
            data-filter-category='all'
            aria-pressed='true'
            class='project-cat-btn cursor-pointer rounded-md border border-accent bg-accent-subtle px-3 py-1.5 text-xs font-semibold text-accent transition-colors'
          >
            All
          </button>
          {categories.map(cat => (
            <button
              type='button'
              data-filter-category={cat}
              aria-pressed='false'
              class='project-cat-btn cursor-pointer rounded-md border border-hairline bg-surface-elevated px-3 py-1.5 text-xs font-medium text-secondary transition-colors hover:border-hairline-strong hover:text-primary'
            >
              {categoryLabel(cat)}
            </button>
          ))}
        </div>

        <div class='flex items-center gap-3'>
          <p
            id='projects-count'
            aria-live='polite'
            class='font-mono text-xs text-secondary tabular-nums'
          >
            Showing {projects.length} of {projects.length} projects
          </p>
          <button
            id='projects-reset-btn'
            type='button'
            hidden
            class='cursor-pointer font-mono text-xs font-medium text-accent underline underline-offset-4 hover:text-accent-hover'
          >
            Reset
          </button>
        </div>
      </div>

      {allTags.length > 0 && (
        <div
          class='flex flex-wrap items-center gap-2 border-t border-hairline pt-4'
          role='group'
          aria-label='Filter by technology or tag'
        >
          <span class='mr-1 font-mono text-xs text-secondary'>
            Tech & Tags:
          </span>
          <button
            type='button'
            data-filter-tag='all'
            aria-pressed='true'
            class='project-tag-btn cursor-pointer rounded-md border border-accent bg-accent-subtle px-2.5 py-1 font-mono text-xs font-medium text-accent transition-colors'
          >
            All
          </button>
          {allTags.map(tag => (
            <button
              type='button'
              data-filter-tag={tag.toLowerCase()}
              aria-pressed='false'
              class='project-tag-btn cursor-pointer rounded-md border border-hairline bg-surface-elevated px-2.5 py-1 font-mono text-xs text-secondary transition-colors hover:border-hairline-strong hover:text-primary'
            >
              {tag}
            </button>
          ))}
        </div>
      )}
    </section>

    <!-- Projects Grid -->
    <section class='mt-8' aria-label='Project list'>
      <div id='projects-grid' class='grid gap-6 md:grid-cols-2'>
        {projects.map(project => (
          <div
            class='project-item'
            data-category={project.data.category}
            data-tags={[...project.data.tech, ...project.data.tags]
              .map(t => t.toLowerCase())
              .join('|')}
          >
            <ProjectCard
              project={project}
              variant={project.data.featured ? 'featured' : 'compact'}
            />
          </div>
        ))}
      </div>

      <div
        id='projects-empty'
        hidden
        class='mt-6 rounded-xl border border-dashed border-hairline-strong bg-surface p-10 text-center'
      >
        <p class='text-base font-semibold text-primary'>
          No projects match the selected filters.
        </p>
        <p class='mt-1.5 text-sm text-secondary'>
          Try clearing the active category or technology filter.
        </p>
        <button
          id='projects-empty-reset'
          type='button'
          class='mt-5 cursor-pointer rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-hover'
        >
          Clear filters
        </button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initProjectsFilter() {
    const items = Array.from(
      document.querySelectorAll<HTMLElement>('.project-item')
    )
    const catButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.project-cat-btn')
    )
    const tagButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.project-tag-btn')
    )
    const countEl = document.getElementById('projects-count')
    const resetBtn = document.getElementById('projects-reset-btn')
    const emptyEl = document.getElementById('projects-empty')
    const emptyResetBtn = document.getElementById('projects-empty-reset')

    if (!items.length || !countEl) return

    const params = new URLSearchParams(window.location.search)
    let activeCategory = params.get('category') || 'all'
    let activeTag = (params.get('tag') || 'all').toLowerCase()

    const validCategories = new Set(
      catButtons.map(btn => btn.dataset.filterCategory || 'all')
    )
    const validTags = new Set(
      tagButtons.map(btn => btn.dataset.filterTag || 'all')
    )
    if (!validCategories.has(activeCategory)) activeCategory = 'all'
    if (!validTags.has(activeTag)) activeTag = 'all'

    function updateUrl() {
      const nextParams = new URLSearchParams()
      if (activeCategory !== 'all') nextParams.set('category', activeCategory)
      if (activeTag !== 'all') nextParams.set('tag', activeTag)
      const query = nextParams.toString()
      const nextUrl = query
        ? `${window.location.pathname}?${query}`
        : window.location.pathname
      window.history.replaceState({}, '', nextUrl)
    }

    function applyButtonStyles(
      buttons: HTMLButtonElement[],
      activeValue: string,
      dataAttr: 'filterCategory' | 'filterTag'
    ) {
      buttons.forEach(btn => {
        const isSelected = btn.dataset[dataAttr] === activeValue
        btn.setAttribute('aria-pressed', String(isSelected))
        btn.classList.toggle('border-accent', isSelected)
        btn.classList.toggle('bg-accent-subtle', isSelected)
        btn.classList.toggle('text-accent', isSelected)
        btn.classList.toggle('font-semibold', isSelected)
        btn.classList.toggle('border-hairline', !isSelected)
        btn.classList.toggle('bg-surface-elevated', !isSelected)
        btn.classList.toggle('text-secondary', !isSelected)
      })
    }

    function render() {
      let visibleCount = 0
      items.forEach(item => {
        const itemCategory = item.dataset.category || ''
        const itemTags = (item.dataset.tags || '').split('|').filter(Boolean)

        const matchesCategory =
          activeCategory === 'all' || itemCategory === activeCategory
        const matchesTag = activeTag === 'all' || itemTags.includes(activeTag)

        const visible = matchesCategory && matchesTag
        item.hidden = !visible
        if (visible) visibleCount += 1
      })

      const noun = items.length === 1 ? 'project' : 'projects'
      if (countEl) {
        countEl.textContent = `Showing ${visibleCount} of ${items.length} ${noun}`
      }
      if (emptyEl) emptyEl.hidden = visibleCount > 0
      if (resetBtn) {
        resetBtn.hidden = activeCategory === 'all' && activeTag === 'all'
      }

      applyButtonStyles(catButtons, activeCategory, 'filterCategory')
      applyButtonStyles(tagButtons, activeTag, 'filterTag')
      updateUrl()
    }

    function resetFilters() {
      activeCategory = 'all'
      activeTag = 'all'
      render()
    }

    catButtons.forEach(btn => {
      btn.onclick = () => {
        activeCategory = btn.dataset.filterCategory || 'all'
        render()
      }
    })

    tagButtons.forEach(btn => {
      btn.onclick = () => {
        activeTag = btn.dataset.filterTag || 'all'
        render()
      }
    })

    if (resetBtn) resetBtn.onclick = resetFilters
    if (emptyResetBtn) emptyResetBtn.onclick = resetFilters

    render()
  }

  document.addEventListener('astro:page-load', initProjectsFilter)
</script>
