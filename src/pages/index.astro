---
import { getCollection } from 'astro:content'
import BlogPostRow from '../components/BlogPostRow.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { profile } from '../data/profile'
import { services } from '../data/services'
import BaseLayout from '../layouts/BaseLayout.astro'

const allProjects = await getCollection('projects')
const sortedProjects = [...allProjects].sort((a, b) => {
  if (a.data.featured !== b.data.featured) {
    return a.data.featured ? -1 : 1
  }
  const timeA = a.data.date ? a.data.date.getTime() : 0
  const timeB = b.data.date ? b.data.date.getTime() : 0
  return timeB - timeA
})
const featuredProjects = sortedProjects.filter(p => p.data.featured).slice(0, 2)
const displayedProjects =
  featuredProjects.length > 0 ? featuredProjects : sortedProjects.slice(0, 2)

const allPosts = await getCollection('blog', ({ data }) => data.published)
const latestPosts = [...allPosts]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const highlightedServices = services.slice(0, 3)
---

<BaseLayout
  title={`${profile.name} — ${profile.headline}`}
  description={profile.bio}
>
  <!-- Hero Section: Asymmetric Editorial + Bento Profile -->
  <section class='border-b border-hairline'>
    <div class='mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8'>
      <div class='grid items-start gap-10 lg:grid-cols-12 lg:gap-12'>
        <div class='lg:col-span-7'>
          <div class='inline-flex items-center gap-2 rounded-full border border-hairline bg-surface px-3 py-1 text-xs font-medium text-secondary'>
            <span
              class='h-2 w-2 rounded-full bg-emerald-500'
              aria-hidden='true'
            ></span>
            <span>Open to full-time AI engineering & consulting</span>
          </div>

          <h1 class='mt-6 text-4xl font-extrabold tracking-tight text-primary sm:text-5xl lg:text-[3.25rem] lg:leading-[1.1]'>
            Engineering reliable AI systems and full-stack web software.
          </h1>

          <p class='mt-5 max-w-2xl text-base leading-relaxed text-secondary sm:text-lg'>
            I’m{' '}
            <span class='font-semibold text-primary' translate='no'>
              {profile.name}
            </span>
            —an {profile.headline} building LLM integrations, RAG pipelines, and
            fast web applications grounded in strong database and infrastructure
            fundamentals.
          </p>

          <div class='mt-8 flex flex-wrap items-center gap-3'>
            <a
              href='/projects'
              class='inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-hover'
            >
              Explore Projects
              <svg
                class='h-4 w-4'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
                aria-hidden='true'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M17 8l4 4m0 0l-4 4m4-4H3'
                />
              </svg>
            </a>

            <a
              href='/contact'
              class='inline-flex items-center rounded-lg border border-hairline bg-surface px-5 py-2.5 text-sm font-semibold text-primary transition-colors hover:border-hairline-strong hover:bg-surface-elevated'
            >
              Start a Conversation
            </a>

            <a
              href='/about'
              class='px-3 py-2.5 text-sm font-medium text-secondary transition-colors hover:text-accent'
            >
              About & Resume
            </a>
          </div>
        </div>

        <aside
          aria-label='Engineering profile snapshot'
          class='rounded-xl border border-hairline bg-surface p-6 lg:col-span-5'
        >
          <div class='flex items-center justify-between border-b border-hairline pb-4'>
            <div>
              <p class='font-mono text-xs text-secondary'>
                Engineering Profile
              </p>
              <p class='mt-0.5 text-base font-bold text-primary' translate='no'>
                {profile.name}
              </p>
            </div>
            <span class='rounded-md border border-hairline bg-surface-elevated px-2.5 py-1 font-mono text-xs text-accent'>
              {profile.location}
            </span>
          </div>

          <dl class='mt-5 space-y-4 text-sm'>
            <div class='flex items-start justify-between gap-4'>
              <dt class='text-secondary'>Primary Focus</dt>
              <dd class='text-right font-medium text-primary'>
                LLM Systems & RAG
              </dd>
            </div>
            <div class='flex items-start justify-between gap-4'>
              <dt class='text-secondary'>Web & Data</dt>
              <dd class='text-right font-medium text-primary'>
                TypeScript, Astro, PostgreSQL
              </dd>
            </div>
            <div class='flex items-start justify-between gap-4'>
              <dt class='text-secondary'>Model Serving</dt>
              <dd class='text-right font-medium text-primary'>
                PyTorch, vLLM, MLOps
              </dd>
            </div>
          </dl>

          <div class='mt-6 flex flex-wrap items-center gap-4 border-t border-hairline pt-4 text-xs font-medium'>
            <a
              href={profile.social.github}
              target='_blank'
              rel='noopener noreferrer'
              class='text-secondary transition-colors hover:text-accent'
            >
              GitHub ↗
            </a>
            <a
              href={profile.social.linkedin}
              target='_blank'
              rel='noopener noreferrer'
              class='text-secondary transition-colors hover:text-accent'
            >
              LinkedIn ↗
            </a>
            <a
              href={`mailto:${profile.email}`}
              class='ml-auto font-mono text-accent transition-colors hover:text-accent-hover'
            >
              {profile.email}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Featured Projects Bento Grid -->
  <section class='border-b border-hairline'>
    <div class='mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8'>
      <div class='flex flex-wrap items-end justify-between gap-4'>
        <div>
          <p class='font-mono text-xs font-medium text-accent'>Selected Work</p>
          <h2 class='mt-1.5 text-2xl font-bold tracking-tight text-primary sm:text-3xl'>
            Featured Projects
          </h2>
        </div>
        <a
          href='/projects'
          class='inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-accent-hover'
        >
          View all projects
          <svg
            class='h-4 w-4'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17 8l4 4m0 0l-4 4m4-4H3'
            />
          </svg>
        </a>
      </div>

      <div class='mt-8 grid gap-6 lg:grid-cols-12'>
        {displayedProjects.map((project, index) => (
          <div
            class:list={[
              displayedProjects.length === 1 && index === 0
                ? 'lg:col-span-8'
                : index === 0
                  ? 'lg:col-span-7'
                  : 'lg:col-span-5',
            ]}
          >
            <ProjectCard
              project={project}
              variant={index === 0 ? 'featured' : 'compact'}
            />
          </div>
        ))}

        {displayedProjects.length === 1 && (
          <div class='flex flex-col justify-between rounded-xl border border-hairline bg-surface p-6 lg:col-span-4'>
            <div>
              <span class='font-mono text-xs font-medium text-accent'>
                Open Source & Consulting
              </span>
              <h3 class='mt-3 text-xl font-bold tracking-tight text-primary'>
                More case studies in the pipeline
              </h3>
              <p class='mt-3 text-sm leading-relaxed text-secondary'>
                I regularly build production RAG pipelines, inference APIs, and
                developer tooling. Explore open-source repositories on GitHub or
                get in touch to discuss architecture work.
              </p>
            </div>

            <div class='mt-8 space-y-3 border-t border-hairline pt-5'>
              <a
                href={profile.social.github}
                target='_blank'
                rel='noopener noreferrer'
                class='flex items-center justify-between rounded-lg border border-hairline bg-surface-elevated px-4 py-2.5 text-sm font-medium text-primary transition-colors hover:border-hairline-strong hover:text-accent'
              >
                <span>Browse GitHub repositories</span>
                <span aria-hidden='true'>↗</span>
              </a>
              <a
                href='/services'
                class='flex items-center justify-between rounded-lg border border-hairline bg-surface-elevated px-4 py-2.5 text-sm font-medium text-primary transition-colors hover:border-hairline-strong hover:text-accent'
              >
                <span>Explore consulting services</span>
                <span aria-hidden='true'>→</span>
              </a>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Services & Capabilities Snapshot -->
  <section class='border-b border-hairline'>
    <div class='mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8'>
      <div class='flex flex-wrap items-end justify-between gap-4'>
        <div>
          <p class='font-mono text-xs font-medium text-accent'>Capabilities</p>
          <h2 class='mt-1.5 text-2xl font-bold tracking-tight text-primary sm:text-3xl'>
            How I Help Teams Ship
          </h2>
        </div>
        <a
          href='/services'
          class='inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-accent-hover'
        >
          All services & process
          <svg
            class='h-4 w-4'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17 8l4 4m0 0l-4 4m4-4H3'
            />
          </svg>
        </a>
      </div>

      <div class='mt-8 grid gap-6 md:grid-cols-3'>
        {highlightedServices.map(service => (
          <div class='flex flex-col justify-between rounded-xl border border-hairline bg-surface p-6'>
            <div>
              <h3 class='text-lg font-bold tracking-tight text-primary'>
                {service.name}
              </h3>
              <p class='mt-2.5 text-sm leading-relaxed text-secondary'>
                {service.description}
              </p>
              <ul class='mt-4 space-y-1.5 text-sm text-secondary'>
                {service.features.slice(0, 3).map(feature => (
                  <li class='flex items-start gap-2'>
                    <span
                      class='mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent'
                      aria-hidden='true'
                    />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class='mt-6 border-t border-hairline pt-4'>
              <a
                href={`/contact?service=${service.id}`}
                class='text-sm font-medium text-accent transition-colors hover:text-accent-hover'
              >
                Inquire about {service.name} →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Blog Writing -->
  <section class='border-b border-hairline'>
    <div class='mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8'>
      <div class='flex flex-wrap items-end justify-between gap-4'>
        <div>
          <p class='font-mono text-xs font-medium text-accent'>
            Technical Writing
          </p>
          <h2 class='mt-1.5 text-2xl font-bold tracking-tight text-primary sm:text-3xl'>
            Latest from the Blog
          </h2>
        </div>
        <a
          href='/blog'
          class='inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-accent-hover'
        >
          Browse all articles
          <svg
            class='h-4 w-4'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17 8l4 4m0 0l-4 4m4-4H3'
            />
          </svg>
        </a>
      </div>

      <div class='mt-8 grid gap-4'>
        {latestPosts.map(post => (
          <BlogPostRow post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section>
    <div class='mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8'>
      <div class='flex flex-col justify-between gap-6 rounded-xl border border-hairline bg-surface p-8 sm:flex-row sm:items-center sm:p-10'>
        <div class='max-w-xl'>
          <p class='font-mono text-xs font-medium text-accent'>Get in Touch</p>
          <h2 class='mt-1.5 text-2xl font-bold tracking-tight text-primary'>
            Hiring an AI Engineer or planning a product build?
          </h2>
          <p class='mt-2.5 text-sm leading-relaxed text-secondary sm:text-base'>
            Reach out directly to discuss full-time opportunities, LLM
            integrations, or technical consulting.
          </p>
        </div>

        <div class='flex shrink-0 flex-wrap items-center gap-3'>
          <a
            href='/contact'
            class='rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-hover'
          >
            Contact Me
          </a>
          <a
            href='/about'
            class='rounded-lg border border-hairline bg-surface-elevated px-5 py-2.5 text-sm font-semibold text-primary transition-colors hover:border-hairline-strong'
          >
            View Resume
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
