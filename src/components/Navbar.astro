---
import { profile } from '../data/profile'

const pathname = Astro.url.pathname

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
]

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/'
  return pathname === href || pathname.startsWith(`${href}/`)
}
---

<header class='sticky top-0 z-50 border-b border-hairline bg-background/85 backdrop-blur-md'>
  <div class='mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8'>
    <a
      href='/'
      class='group flex items-center gap-2.5 text-sm font-semibold tracking-tight text-primary transition-colors hover:text-accent'
    >
      <span
        class='inline-flex h-8 w-8 items-center justify-center rounded-md border border-hairline bg-surface font-mono text-xs font-semibold text-accent transition-colors group-hover:border-accent'
        translate='no'
      >
        PP
      </span>
      <span translate='no'>{profile.name}</span>
    </a>

    <nav
      aria-label='Primary navigation'
      class='hidden items-center gap-1 md:flex'
    >
      {navLinks.map(link => {
        const active = isActive(link.href)
        return (
          <a
            href={link.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm font-medium transition-colors',
              active
                ? 'bg-accent-subtle text-accent'
                : 'text-secondary hover:bg-surface hover:text-primary',
            ]}
          >
            {link.label}
          </a>
        )
      })}
    </nav>

    <div class='flex items-center gap-2'>
      <button
        id='theme-toggle'
        type='button'
        class='inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-md border border-hairline bg-surface text-secondary transition-colors hover:border-hairline-strong hover:text-primary'
        aria-label='Toggle color theme'
      >
        <!-- Sun icon: shown in dark mode -->
        <svg
          class='hidden h-4 w-4 dark:block'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
          aria-hidden='true'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z'
          />
        </svg>
        <!-- Moon icon: shown in light mode -->
        <svg
          class='block h-4 w-4 dark:hidden'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
          aria-hidden='true'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z'
          />
        </svg>
      </button>

      <button
        id='mobile-menu-button'
        type='button'
        class='inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-md border border-hairline bg-surface text-secondary transition-colors hover:border-hairline-strong hover:text-primary md:hidden'
        aria-label='Toggle navigation menu'
        aria-expanded='false'
        aria-controls='mobile-menu'
      >
        <svg
          id='mobile-menu-open-icon'
          class='h-5 w-5'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
          aria-hidden='true'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M4 6h16M4 12h16M4 18h16'
          />
        </svg>
        <svg
          id='mobile-menu-close-icon'
          class='hidden h-5 w-5'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
          aria-hidden='true'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M6 18L18 6M6 6l12 12'
          />
        </svg>
      </button>
    </div>
  </div>

  <div
    id='mobile-menu'
    hidden
    class='border-t border-hairline bg-surface overscroll-contain md:hidden'
  >
    <nav
      aria-label='Mobile navigation'
      class='mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3 sm:px-6'
    >
      {navLinks.map(link => {
        const active = isActive(link.href)
        return (
          <a
            href={link.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              active
                ? 'bg-accent-subtle text-accent'
                : 'text-secondary hover:bg-surface-elevated hover:text-primary',
            ]}
          >
            {link.label}
          </a>
        )
      })}
    </nav>
  </div>
</header>

<script>
  function initNavbar() {
    const root = document.documentElement
    const themeToggle = document.getElementById('theme-toggle')
    const menuButton = document.getElementById('mobile-menu-button')
    const mobileMenu = document.getElementById('mobile-menu')
    const openIcon = document.getElementById('mobile-menu-open-icon')
    const closeIcon = document.getElementById('mobile-menu-close-icon')

    function setTheme(nextTheme: 'light' | 'dark') {
      const meta = document.getElementById('theme-color-meta')
      if (nextTheme === 'light') {
        root.classList.remove('dark')
        root.setAttribute('data-theme', 'light')
        if (meta) meta.setAttribute('content', '#FAFAFC')
      } else {
        root.classList.add('dark')
        root.setAttribute('data-theme', 'dark')
        if (meta) meta.setAttribute('content', '#090D16')
      }
      try {
        localStorage.setItem('theme', nextTheme)
      } catch {}
    }

    if (themeToggle) {
      themeToggle.onclick = () => {
        const isDark = root.classList.contains('dark')
        setTheme(isDark ? 'light' : 'dark')
      }
    }

    function setMenuOpen(open: boolean) {
      if (!menuButton || !mobileMenu) return
      menuButton.setAttribute('aria-expanded', String(open))
      mobileMenu.hidden = !open
      if (openIcon && closeIcon) {
        openIcon.classList.toggle('hidden', open)
        closeIcon.classList.toggle('hidden', !open)
      }
    }

    setMenuOpen(false)

    if (menuButton && mobileMenu) {
      menuButton.onclick = () => {
        const currentlyOpen =
          menuButton.getAttribute('aria-expanded') === 'true'
        setMenuOpen(!currentlyOpen)
      }

      mobileMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => setMenuOpen(false))
      })
    }

    if (!(window as unknown as { __navEscBound?: boolean }).__navEscBound) {
      ;(window as unknown as { __navEscBound?: boolean }).__navEscBound = true
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
          const btn = document.getElementById('mobile-menu-button')
          const menu = document.getElementById('mobile-menu')
          const openIc = document.getElementById('mobile-menu-open-icon')
          const closeIc = document.getElementById('mobile-menu-close-icon')
          if (btn && menu && !menu.hidden) {
            btn.setAttribute('aria-expanded', 'false')
            menu.hidden = true
            openIc?.classList.remove('hidden')
            closeIc?.classList.add('hidden')
            btn.focus()
          }
        }
      })
    }
  }

  document.addEventListener('astro:page-load', initNavbar)
</script>
