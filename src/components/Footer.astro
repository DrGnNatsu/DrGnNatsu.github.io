---
import { profile } from '../data/profile'

const currentYear = new Date().getFullYear()

const quickLinks = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
]
---

<footer class='mt-auto border-t border-hairline bg-surface'>
  <div class='mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8'>
    <div class='flex flex-col justify-between gap-8 md:flex-row md:items-center'>
      <div class='space-y-1.5'>
        <p class='text-sm font-semibold text-primary' translate='no'>
          {profile.name}
        </p>
        <p class='text-xs text-secondary'>
          {profile.headline} · Full-stack web, LLM systems, and consulting.
        </p>
      </div>

      <nav
        aria-label='Footer navigation'
        class='flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-secondary'
      >
        {quickLinks.map(link => (
          <a href={link.href} class='transition-colors hover:text-accent'>
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class='mt-8 flex flex-col justify-between gap-4 border-t border-hairline pt-6 text-xs text-secondary sm:flex-row sm:items-center'>
      <p>
        © {currentYear} {profile.name}. Built with Astro & Tailwind CSS.
      </p>

      <div class='flex flex-wrap items-center gap-5'>
        <a
          href={`mailto:${profile.email}`}
          class='font-mono transition-colors hover:text-accent'
        >
          {profile.email}
        </a>
        <a
          href={profile.social.github}
          target='_blank'
          rel='noopener noreferrer'
          class='transition-colors hover:text-accent'
        >
          GitHub
        </a>
        <a
          href={profile.social.linkedin}
          target='_blank'
          rel='noopener noreferrer'
          class='transition-colors hover:text-accent'
        >
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</footer>
