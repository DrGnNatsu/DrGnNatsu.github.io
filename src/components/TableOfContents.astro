---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3)
---

{tocHeadings.length > 0 && (
  <aside aria-label='Table of contents'>
    {/* Mobile collapsible TOC */}
    <details class='rounded-xl border border-hairline bg-surface p-4 lg:hidden'>
      <summary class='cursor-pointer font-mono text-xs font-semibold tracking-wide text-primary'>
        On this page
      </summary>
      <nav class='mt-3 border-t border-hairline pt-3'>
        <ul class='space-y-2 text-sm'>
          {tocHeadings.map(heading => (
            <li class={heading.depth === 3 ? 'pl-4' : ''}>
              <a
                href={`#${heading.slug}`}
                class='text-secondary transition-colors hover:text-accent'
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>

    {/* Desktop sticky TOC */}
    <div class='hidden rounded-xl border border-hairline bg-surface p-5 lg:sticky lg:top-24 lg:block'>
      <p class='font-mono text-xs font-semibold tracking-wide text-primary'>
        On this page
      </p>
      <nav class='mt-3 border-t border-hairline pt-3'>
        <ul class='space-y-2 text-sm'>
          {tocHeadings.map(heading => (
            <li class={heading.depth === 3 ? 'pl-3.5' : ''}>
              <a
                href={`#${heading.slug}`}
                class='block text-secondary transition-colors hover:text-accent'
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </aside>
)}
