---
import type { CollectionEntry } from 'astro:content'
import { estimateReadingTime, formatDate } from '../utils/format'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, tags, date, readingTime } = post.data
const computedReadingTime = estimateReadingTime(post.body, readingTime)
const href = `/blog/${post.id}`
---

<article
  class='group rounded-xl border border-hairline bg-surface p-6 transition-[border-color] duration-200 hover:border-hairline-strong'
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
  data-tags={tags.join('|').toLowerCase()}
>
  <div class='flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-secondary tabular-nums'>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span aria-hidden='true'>·</span>
    <span>{computedReadingTime}</span>
  </div>

  <h3 class='mt-2.5 text-lg font-bold tracking-tight text-primary sm:text-xl'>
    <a href={href} class='transition-colors hover:text-accent'>
      {title}
    </a>
  </h3>

  <p class='mt-2 text-sm leading-relaxed text-secondary'>{description}</p>

  <div class='mt-4 flex flex-wrap items-center justify-between gap-3'>
    {tags.length > 0 && (
      <ul class='flex flex-wrap gap-1.5' aria-label='Article tags'>
        {tags.map(tag => (
          <li class='rounded-md border border-hairline bg-surface-elevated px-2 py-0.5 font-mono text-xs text-secondary'>
            #{tag}
          </li>
        ))}
      </ul>
    )}

    <a
      href={href}
      class='inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-accent-hover'
    >
      Read article
      <svg
        class='h-3.5 w-3.5'
        fill='none'
        viewBox='0 0 24 24'
        stroke='currentColor'
        stroke-width='2'
        aria-hidden='true'
      >
        <path
          stroke-linecap='round'
          stroke-linejoin='round'
          d='M17 8l4 4m0 0l-4 4m4-4H3'
        />
      </svg>
    </a>
  </div>
</article>
